# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Gropius build artifacts
/bin/
/dist/
/client/dist/
/release-artifacts/
# The rendered landing page (make site). Composed from committed files by
# cmd/gropius-site and rendered again by the deploy workflow, so it is an
# artefact, not a source.
/site/
# NOTE: build/AppIcon.icns IS committed, and `make app` copies it rather than
# regenerating it, so CI can build the server app on a clean checkout without
# librsvg. `make icon` rebuilds it from build/icon.svg by hand. Only the
# transient rasterisation artefacts are ignored.
/build/icon-1024.png
/build/AppIcon.iconset/
.DS_Store

# Per-machine working state (the gitignored local tier described in AGENTS.md).
/.abcd/.work.local/

# BEGIN ABCD
# abcd-managed block — do not hand-edit. Run /abcd:ahoy to refresh.
.abcd/.work.local/
/memory/
# END ABCD
