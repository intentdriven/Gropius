<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>GropiusChat</string>
    <key>CFBundleDisplayName</key>
    <string>Gropius Chat</string>
    <key>CFBundleIdentifier</key>
    <string>dev.gropius.chat</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleExecutable</key>
    <string>GropiusChat</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- The client talks to a plain-HTTP server on the LAN. NSAllowsLocalNetworking
         permits exactly that (.local / RFC1918 / loopback cleartext) WITHOUT
         disabling App Transport Security for public hosts. NSAllowsArbitraryLoads
         is deliberately NOT set: it would let a mistyped public http:// address
         send the bearer token in cleartext over the internet with no warning. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- Reaching a peer over the LAN triggers macOS Local Network Privacy. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Gropius Chat connects to a Gropius model server on your local network.</string>
    <!-- The Bonjour service types the app may browse for. macOS answers a browse
         for an undeclared type with an empty result set rather than an error, so
         an omission here is indistinguishable from "no servers on this network".
         This is the type the server advertises (internal/discovery). -->
    <key>NSBonjourServices</key>
    <array>
        <string>_gropius._tcp</string>
    </array>
</dict>
</plist>
